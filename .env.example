# CALM_GEMINI_KEY: Required for Gemini AI API calls.
# Users configure this via the Settings / Secrets panel.
# We use 'CALM' prefix to avoid reserved name issues with platform defaults.
CALM_GEMINI_KEY="PASTE_YOUR_GEMINI_KEY_HERE"

# OPENROUTER_API_KEY: Used for AI logic (OpenRouter).
VITE_OPEN_ROUTER_KEY=
VITE_OPENROUTER_API_KEY=

# SUPABASE_URL: Required for Supabase integration.
VITE_SUPABASE_URL=

# SUPABASE_ANON_KEY: Required for Supabase integration.
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Required for admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# PAYSTACK_SECRET_KEY: Required for payment verification.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"

# BREVO_API_KEY: Required for sending emails via Brevo API.
BREVO_API_KEY=

# BREVO_SENDER_EMAIL: The verified sender email in your Brevo account.
BREVO_SENDER_EMAIL=

# CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN: Required for Cloudflare Workers AI Image Generation (flux-1-schnell & SDXL)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare private Worker URL for secure client-side image generation (without API keys exposure)
VITE_IMAGE_WORKER_URL=

# Supabase Webhook secret token for securing the user-confirmed callback
WEBHOOK_SECRET=

# Recipient email address for admin signup notifications
ADMIN_EMAIL=


